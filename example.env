# Deployment configuration. Copy to .env (git-ignored) and fill it in.
#
# Compose reads .env twice: for the ${...} substitutions in
# docker-compose.yml, and again as env_file so the app sees these values too.

# --- auth ---
AUTH_ENABLED=false
KEYCLOAK_SERVER_URL=https://idp-test.nationaldataplatform.org
KEYCLOAK_REALM=NDP
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- infra ---
# Base URL the app is served at, e.g. http://localhost:8099
APP_BASE_URL=

# Signs the session cookie. If left blank, a random value is auto-generated per
# process. In prod, set a fixed value, otherwise every restart logs all users
# out and multiple workers reject each other's cookies.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# --- data ---
# Where each dataset's ground-truth beats live ON THE HOST. Leave one blank and
# comment out its volume in docker-compose.yml to run without that dataset --
# the UI then reports it as unavailable. The container-side paths are fixed at
# /data/ground-truth/<dataset> and are not configured here.
ECGI_GT_UTAH_HOST=
ECGI_GT_AUCKLAND_HOST=
ECGI_GT_HALIFAX_HOST=
ECGI_GT_BRATISLAVA_HOST=

# Where submitted zips and their scores are kept on the host.
# Defaults to ./submissions next to docker-compose.yml.
ECGI_SUBMISSIONS_HOST=
