# auth
AUTH_ENABLED=false
KEYCLOAK_SERVER_URL=https://idp-test.nationaldataplatform.org
KEYCLOAK_REALM=NDP
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# infra - base URL the app is served at
APP_BASE_URL=

# Signs the session cookie. If left blank, a random value is
# auto-generated per process. In prod, set a fixed value, otherwise every
# restart logs all users out and multiple workers reject each other's cookies.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=